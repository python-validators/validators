# Documentation
name: docs
on:
  workflow_dispatch:
  push:
    branches: ["master"]
jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    env:
      BUILD_PATH: .
    steps:
      # checkout repository
      - name: Checkout repository
        uses: actions/checkout@v7
      # set up uv and a specific python version
      - name: Set up uv with Python v3.12
        uses: astral-sh/setup-uv@v10.3.0
        with:
          python-version: "3.12"
      # building
      - name: Install 'documentation' dependencies
        run: uv sync --locked --no-editable --group docs-online --extra crypto-eth-addresses
      - name: Build documentation
        run: uv run --no-sync python package/export doc
      # set up Pages
      - name: Set up Pages
        uses: actions/configure-pages@v6
      # upload static page
      - name: Upload artifact
        uses: actions/upload-pages-artifact@v5
        with:
          path: ${{ env.BUILD_PATH }}/site
  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    # deploy documentation
    name: Deploy
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
